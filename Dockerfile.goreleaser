# Used by GoReleaser only. The binary is already compiled for the target arch
# and placed in the build context; this just wraps it.
#
# distroless/static, NOT scratch — the relay verifies Zulip's certificate on
# every send, so it needs a CA bundle. (The developer Dockerfile carries the
# same note.)
FROM gcr.io/distroless/static-debian12:nonroot

# ★ dockers_v2 lays the binaries out per platform in the build context —
# linux/amd64/zulip-smtp, linux/arm64/zulip-smtp — so one Dockerfile serves
# every arch. TARGETPLATFORM is set automatically by buildx; a plain
# `COPY zulip-smtp` finds nothing and fails with "not found".
ARG TARGETPLATFORM
COPY ${TARGETPLATFORM}/zulip-smtp /usr/local/bin/zulip-smtp

USER nonroot:nonroot
EXPOSE 1025 8080

ENTRYPOINT ["/usr/local/bin/zulip-smtp"]
